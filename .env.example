jwt.secret=replace-with-a-random-64-character-hex-secret
jwt.expiration=1200000
jwt.refresh.expiration=3600000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
mail.username=your-smtp-account
mail.password=your-smtp-app-password
mfa.encryption.key=replace-with-a-random-32-character-ascii-key
PASSWORD_RESET_URL=http://localhost:4200/reset-password?token=
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://esibuy.web.app
